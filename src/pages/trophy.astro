---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import TrophySprite from "../components/ceefax/TrophySprite.astro";
import { WEEKS } from "../data/matches";
import { computeStandings } from "../data/standings";

const base = import.meta.env.BASE_URL;
const champion = computeStandings(WEEKS)[0];
const confettiColors = [
  "var(--ceefax-yellow)",
  "var(--ceefax-cyan)",
  "var(--ceefax-magenta)",
  "var(--ceefax-green)",
  "var(--ceefax-white)",
];
const confetti = Array.from({ length: 40 }, (_, i) => ({
  x: `${(i * 37) % 100}%`,
  delay: `${(i % 8) * 0.17}s`,
  duration: `${2.4 + (i % 5) * 0.35}s`,
  color: confettiColors[i % confettiColors.length] ?? "var(--ceefax-yellow)",
  drift: `${((i % 7) - 3) * 14}px`,
  spin: `${(i % 2 === 0 ? 1 : -1) * (180 + (i % 3) * 90)}deg`,
}));
---

<CeefaxLayout title="TROPHY" pageNumber="600">
  <CeefaxHeading text="TROPHY" color="yellow" />
  <div class="trophy-wrap">
    <CeefaxBlock title="CHAMPIONS TROPHY" number="600" color="yellow">
      <div class="trophy-display">
        <div class="confetti" aria-hidden="true">
          {
            confetti.map((piece) => (
              <span
                class="confetti-piece"
                style={`--x: ${piece.x}; --delay: ${piece.delay}; --duration: ${piece.duration}; --color: ${piece.color}; --drift: ${piece.drift}; --spin: ${piece.spin};`}
              />
            ))
          }
        </div>
        <TrophySprite />
        <div class="trophy-nameplate">
          <span class="nameplate-label">CHAMPION</span>
          <a
            class="nameplate-name"
            href={`${base}trainers/${champion.player.number}`}
          >
            <span>{champion.player.name}</span>
            <span class="nameplate-epithet">{champion.player.epithet}</span>
          </a>
        </div>
      </div>
      <p class="trophy-note">SEASON 3 COMPLETE</p>
      <p class="trophy-detail">
        {champion.wins} MATCH WINS / {champion.battles} BATTLE WINS.
      </p>
    </CeefaxBlock>
  </div>
</CeefaxLayout>

<style>
  .trophy-wrap {
    grid-column: 1 / -1;
    justify-self: center;
    width: fit-content;
    max-width: 100%;
  }

  .trophy-wrap :global(.ceefax-block) {
    width: fit-content;
    max-width: 100%;
  }

  .trophy-display {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 0.5rem 0;
  }

  .trophy-display :global(.trophy-sprite),
  .trophy-nameplate {
    position: relative;
    z-index: 1;
  }

  .confetti {
    position: absolute;
    inset: -1.5rem 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .confetti-piece {
    position: absolute;
    top: -0.75rem;
    left: var(--x);
    width: 0.4rem;
    height: 0.7rem;
    background: var(--color);
    opacity: 0;
    animation: confetti-fall var(--duration) linear var(--delay) infinite;
  }

  @keyframes confetti-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, -0.75rem, 0) rotate(0deg);
    }
    12% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), 16rem, 0) rotate(var(--spin));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .confetti {
      display: none;
    }
  }

  .trophy-nameplate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    border: 3px solid var(--ceefax-black);
    background: var(--ceefax-black);
    color: var(--ceefax-yellow);
    padding: 0.5rem 2rem;
    min-width: 12rem;
  }

  .nameplate-label {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--ceefax-white);
  }

  .nameplate-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: var(--ceefax-yellow);
    text-decoration: none;
    text-transform: uppercase;
  }

  .nameplate-name:hover {
    color: var(--ceefax-cyan);
  }

  .nameplate-epithet {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--ceefax-cyan);
  }

  .nameplate-name:hover .nameplate-epithet {
    color: var(--ceefax-yellow);
  }

  .trophy-note {
    margin: 0.75rem 0 0;
    text-align: center;
    font-weight: 700;
    color: var(--ceefax-green);
  }

  .trophy-detail {
    margin: 0.5rem 0 0;
    text-align: center;
    color: var(--ceefax-white);
  }
</style>
