---
import CeefaxLayout from '../../layouts/CeefaxLayout.astro';
import CeefaxBlock from '../../components/ceefax/CeefaxBlock.astro';
import CeefaxHeading from '../../components/ceefax/CeefaxHeading.astro';
import HeadToHeadTable from '../../components/ceefax/HeadToHeadTable.astro';
import SectionNav from '../../components/ceefax/SectionNav.astro';
import { PLAYERS } from '../../data/players';
import { STANDINGS_PAGE, STANDINGS_CHILD_PAGES } from '../../data/navigation';

const players = [...PLAYERS].sort((a, b) => a.number - b.number);
---

<CeefaxLayout title="HEAD TO HEAD - 2ND HALF" pageNumber="302">
	<CeefaxHeading text="HEAD TO HEAD - 2ND HALF" color="magenta" />
	<div class="h2h-wrap">
		<CeefaxBlock title="HEAD TO HEAD - 2ND HALF" number="302" color="magenta">
			<HeadToHeadTable players={players} headToHead={new Map()} />
		</CeefaxBlock>
	</div>
	<SectionNav children={STANDINGS_CHILD_PAGES} current="302" main={STANDINGS_PAGE} />
</CeefaxLayout>

<style>
	.h2h-wrap {
		grid-column: 1 / -1;
		justify-self: center;
		width: fit-content;
		max-width: 100%;
	}

	.h2h-wrap :global(.ceefax-block) {
		width: fit-content;
		max-width: 100%;
	}

	.h2h-wrap :global(.ceefax-block-body) {
		overflow-x: auto;
	}
</style>
