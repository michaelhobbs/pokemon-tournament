---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PageDirectory from "../components/ceefax/PageDirectory.astro";
import StandingsTable from "../components/ceefax/StandingsTable.astro";
import { STANDINGS_PAGE, STANDINGS_CHILD_PAGES } from "../data/navigation";
import { WEEKS, FIRST_HALF_WEEKS, SECOND_HALF_WEEKS } from "../data/matches";
---

<CeefaxLayout title="STANDINGS" pageNumber="300">
  <CeefaxHeading text="STANDINGS" color="cyan" />
  <PageDirectory
    pages={[STANDINGS_PAGE, ...STANDINGS_CHILD_PAGES]}
    title="STANDINGS DIRECTORY"
    number="300"
    color="green"
  />
  <div class="standings-section">
    <CeefaxBlock title="STANDINGS OVERALL" number="300" color="cyan">
      <StandingsTable weeks={WEEKS} />
    </CeefaxBlock>
  </div>
  <div class="standings-section">
    <CeefaxBlock title="STANDINGS 1ST HALF" number="300" color="green">
      <StandingsTable weeks={FIRST_HALF_WEEKS} />
    </CeefaxBlock>
  </div>
  <div class="standings-section">
    <CeefaxBlock title="STANDINGS 2ND HALF" number="300" color="magenta">
      <StandingsTable weeks={SECOND_HALF_WEEKS} />
    </CeefaxBlock>
  </div>
</CeefaxLayout>

<style>
  :global(.ceefax-block-body) {
    overflow-x: auto;
  }

  .standings-section {
    grid-column: 1 / -1;
  }
</style>
