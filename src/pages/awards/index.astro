---
import CeefaxLayout from "../../layouts/CeefaxLayout.astro";
import CeefaxHeading from "../../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../../components/ceefax/PixelArt.astro";
import {
  awardDisplayName,
  awardDisplayDescription,
  awardDisplaySprite,
  awardWinners,
  DISTRIBUTE_AWARDS,
  SHOW_AWARD_PROGRESS,
  type Award,
} from "../../data/awards";
import {
  getDistributedAwards,
  getAwardRankings,
  getAwardProgressLeaders,
} from "../../data/award-distribution";
import { findPlayer } from "../../data/players";

const awards = getDistributedAwards();
const rankings = getAwardRankings();
const leaders = getAwardProgressLeaders();

interface ProgressLeader {
  name: string;
  score?: string;
}

function progressLeadersFor(award: Award): ProgressLeader[] {
  if (award.hidden || awardWinners(award).length > 0) return [];
  return (leaders.get(award.number) ?? []).map((playerNumber) => {
    const player = findPlayer(playerNumber);
    const entry = rankings
      .get(award.number)
      ?.find((r) => r.playerNumber === playerNumber);
    return {
      name: player ? player.name : String(playerNumber),
      score: entry?.scoreLabel,
    };
  });
}

function progressLabel(progressLeaders: ProgressLeader[]): string {
  if (progressLeaders.length > 3) {
    return `${progressLeaders.length} TRAINERS TIED`;
  }
  const prefix = progressLeaders.length === 1 ? "LEADING: " : "JOINT LEAD: ";
  return (
    prefix +
    progressLeaders
      .map((leader) =>
        leader.score ? `${leader.name} (${leader.score})` : leader.name,
      )
      .join(" / ")
  );
}

const progressByAward = new Map<number, ProgressLeader[]>(
  awards.map((award) => [award.number, progressLeadersFor(award)]),
);

const awardsNote = DISTRIBUTE_AWARDS
  ? "AWARDS FINAL."
  : SHOW_AWARD_PROGRESS
    ? "CURRENT LEADERS SHOWN — WINNERS REVEALED AT THE END OF THE SEASON."
    : "WINNERS REVEALED AT THE END OF THE SEASON.";
---

<CeefaxLayout title="AWARDS" pageNumber="700">
  <CeefaxHeading text="END OF SEASON AWARDS" color="yellow" />
  <ul class="award-grid">
    {
      awards.map((award) => (
        <li>
          <a
            class="award-card"
            data-hidden={award.hidden}
            href={`${import.meta.env.BASE_URL}awards/${award.number}`}
          >
            <span class="award-sprite">
              <PixelArt sprite={awardDisplaySprite(award)} size="6rem" />
            </span>
            <span class="award-number">{award.number}</span>
            <span class="award-name">{awardDisplayName(award)}</span>
            <span class="award-desc">{awardDisplayDescription(award)}</span>
            {!award.hidden && awardWinners(award).length > 0 && (
              <span class="award-winners">
                WINNER{awardWinners(award).length !== 1 ? "S" : ""}:{" "}
                {awardWinners(award).map((w, i) => {
                  const p = findPlayer(w);
                  const name = p ? p.name : String(w);
                  const rank = rankings.get(award.number);
                  const entry = rank?.find((r) => r.playerNumber === w);
                  return (
                    <>
                      {i > 0 && ", "}
                      {name}
                      {entry ? ` (${entry.scoreLabel})` : ""}
                    </>
                  );
                })}
              </span>
            )}
            {progressByAward.get(award.number)?.length ? (
              <span class="award-progress">
                {progressLabel(progressByAward.get(award.number)!)}
              </span>
            ) : null}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="awards-note">{awardsNote}</p>
</CeefaxLayout>

<style>
  .award-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .award-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .award-grid {
      grid-template-columns: 1fr;
    }
  }

  .award-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    border: 1px solid var(--ceefax-yellow);
    padding: 0.75rem 0.5rem;
    text-align: center;
    height: 100%;
    box-sizing: border-box;
  }

  .award-card:hover {
    background: var(--ceefax-yellow);
  }

  .award-card[data-hidden="true"] {
    border-style: dashed;
    border-color: var(--ceefax-magenta);
  }

  .award-card[data-hidden="true"] .award-number {
    background: var(--ceefax-magenta);
  }

  .award-card[data-hidden="true"] .award-name {
    color: var(--ceefax-magenta);
  }

  .award-card[data-hidden="true"]:hover .award-name {
    color: var(--ceefax-black);
  }

  .award-sprite {
    display: block;
  }

  .award-number {
    background: var(--ceefax-black);
    color: var(--ceefax-yellow);
    font-weight: 700;
    padding: 0 0.4rem;
  }

  .award-name {
    color: var(--ceefax-yellow);
    font-weight: 700;
  }

  .award-desc {
    color: var(--ceefax-white);
    font-size: 0.8rem;
  }

  .award-card:hover .award-desc {
    color: var(--ceefax-black);
  }

  .award-card:hover .award-name {
    color: var(--ceefax-black);
  }

  .award-winners {
    color: var(--ceefax-green);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .award-card:hover .award-winners {
    color: var(--ceefax-black);
  }

  .award-progress {
    color: var(--ceefax-cyan);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .award-card:hover .award-progress {
    color: var(--ceefax-black);
  }

  .awards-note {
    margin: 0.75rem 0 0;
    color: var(--ceefax-yellow);
    font-weight: 700;
    grid-column: 1 / -1;
  }
</style>
