---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../components/ceefax/PixelArt.astro";
import SecretAwardBanner from "../components/ceefax/SecretAwardBanner.astro";
import SecretQuote from "../components/ceefax/SecretQuote.astro";
import { DBZ_SPRITE } from "../data/hidden-humons";
---

<CeefaxLayout title="DBZMON" pageNumber="329">
  <SecretQuote />
  <div class="secret-block">
    <div class="secret-sprite-row">
      <PixelArt sprite={DBZ_SPRITE} size="8rem" />
      <span class="mgr-secret-ball" data-secret-ball="dbz"></span>
    </div>
    <CeefaxHeading text="DBZMON" color="red" />
    <CeefaxBlock title="POWER LEVEL OVER 9000" color="red">
      <p>IT'S STILL TRAINING ON THE WAY TO THE BATTLE.</p>
      <p>IT GOES EVEN FURTHER BEYOND. SCREAMING IS UNDERSTOOD.</p>
      <p>CATCH IT WITH A DBZBALL FROM THE POKESHOP ON PAGE 810.</p>
    </CeefaxBlock>
    <div class="mgr-app" data-manager-secret="dbz"></div>
    <SecretAwardBanner />
  </div>
</CeefaxLayout>

<style>
  .secret-block {
    grid-column: 1 / -1;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .secret-block :global(.ceefax-block) {
    width: 100%;
    max-width: 100%;
  }
</style>
