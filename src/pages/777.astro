---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../components/ceefax/PixelArt.astro";
import SecretAwardBanner from "../components/ceefax/SecretAwardBanner.astro";
import SecretQuote from "../components/ceefax/SecretQuote.astro";
import { ANGEL_SPRITE } from "../data/hidden-humons";
---

<CeefaxLayout title="ANGELMON" pageNumber="777">
  <SecretQuote />
  <div class="secret-block">
    <div class="secret-sprite-row">
      <PixelArt sprite={ANGEL_SPRITE} size="8rem" />
      <span class="mgr-secret-ball" data-secret-ball="angel"></span>
    </div>
    <CeefaxHeading text="ANGELMON" color="white" />
    <CeefaxBlock title="THE WATCHER" color="white">
      <p>AN ABOVE-WATER HUMON. EVERY BATTLE IS WITNESSED.</p>
      <p>
        EVERY LOSS IS JUDGED. IT NEVER BLINKS FROM THE TOP OF THE LEADERBOARD.
      </p>
      <p>CATCH IT WITH AN ANGELBALL FROM THE POKESHOP ON PAGE 810.</p>
    </CeefaxBlock>
    <div class="mgr-app" data-manager-secret="angel"></div>
    <SecretAwardBanner />
  </div>
</CeefaxLayout>

<style>
  .secret-block {
    grid-column: 1 / -1;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .secret-block :global(.ceefax-block) {
    width: 100%;
    max-width: 100%;
  }
</style>
