---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../components/ceefax/PixelArt.astro";
import SecretAwardBanner from "../components/ceefax/SecretAwardBanner.astro";
import SecretQuote from "../components/ceefax/SecretQuote.astro";
import { COP_SPRITE } from "../data/hidden-humons";
---

<CeefaxLayout title="COPMON" pageNumber="999">
  <SecretQuote />
  <div class="secret-block">
    <PixelArt sprite={COP_SPRITE} size="8rem" />
    <CeefaxHeading text="COPMON" color="blue" />
    <CeefaxBlock title="THE LAW" color="blue">
      <p>A HUMON WHO BECAME THE POLICE.</p>
      <p>IT PUTS TYPE CHARTS IN THEIR PLACE.</p>
      <p>RECRUIT IT TO YOUR HUMON MANAGER SQUAD FOR CURRENCY.</p>
    </CeefaxBlock>
    <div class="mgr-app" data-manager-secret="cop"></div>
    <SecretAwardBanner />
  </div>
</CeefaxLayout>

<style>
  .secret-block {
    grid-column: 1 / -1;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .secret-block :global(.ceefax-block) {
    width: 100%;
    max-width: 100%;
  }
</style>
