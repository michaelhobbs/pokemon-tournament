---
import CeefaxLayout from "../../layouts/CeefaxLayout.astro";
import CeefaxHeading from "../../components/ceefax/CeefaxHeading.astro";
import SectionNav from "../../components/ceefax/SectionNav.astro";
import ManagerApp from "../../components/ceefax/ManagerApp.astro";
import { MANAGER_PAGE, MANAGER_CHILD_PAGES } from "../../data/navigation";
---

<CeefaxLayout title="TRAVEL" pageNumber="812">
  <CeefaxHeading text="TRAVEL" color="green" />
  <ManagerApp feature="travel" />
  <SectionNav
    children={MANAGER_CHILD_PAGES}
    current="812"
    main={MANAGER_PAGE}
  />
</CeefaxLayout>
