---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../components/ceefax/PixelArt.astro";
import SecretAwardBanner from "../components/ceefax/SecretAwardBanner.astro";
import SecretQuote from "../components/ceefax/SecretQuote.astro";
import { SEX_SPRITE } from "../data/hidden-humons";
---

<CeefaxLayout title="SEXMON" pageNumber="069">
  <SecretQuote />
  <div class="secret-block">
    <div class="secret-sprite-row">
      <PixelArt sprite={SEX_SPRITE} size="8rem" />
      <span class="mgr-secret-ball" data-secret-ball="sex"></span>
    </div>
    <CeefaxHeading text="SEXMON" color="magenta" />
    <CeefaxBlock title="69. NICE." color="magenta">
      <p>IT'S EXACTLY WHAT YOU THINK IT IS.</p>
      <p>EVERY ROUND IS A ROUND. IT HAS NEVER LOST A ONE-NIGHT READ.</p>
      <p>CATCH IT WITH A SEXBALL FROM THE POKESHOP ON PAGE 810.</p>
    </CeefaxBlock>
    <div class="mgr-app" data-manager-secret="sex"></div>
    <SecretAwardBanner />
  </div>
</CeefaxLayout>

<style>
  .secret-block {
    grid-column: 1 / -1;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .secret-block :global(.ceefax-block) {
    width: 100%;
    max-width: 100%;
  }
</style>
