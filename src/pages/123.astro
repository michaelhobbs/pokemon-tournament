---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../components/ceefax/CeefaxHeading.astro";
import PixelArt from "../components/ceefax/PixelArt.astro";
import SecretAwardBanner from "../components/ceefax/SecretAwardBanner.astro";
import SecretQuote from "../components/ceefax/SecretQuote.astro";
import { JOAk_SPRITE, JOAk_JOKES } from "../data/professor-joak";
---

<CeefaxLayout title="PROFESSOR JOAK" pageNumber="123">
  <SecretQuote />
  <div class="secret-block">
    <div class="secret-sprite-row">
      <PixelArt
        sprite={JOAk_SPRITE}
        size="8rem"
        label="Professor Joak sprite"
      />
      <span class="mgr-secret-ball" data-secret-ball="joak"></span>
    </div>
    <CeefaxHeading text="PROFESSOR JOAK" color="cyan" />
    <p class="joak-tagline">POKEMON TRAINER TRAINER</p>
    <CeefaxBlock title="A FEW JOKES" color="cyan">
      {JOAk_JOKES.map((joke) => <p>{joke}</p>)}
    </CeefaxBlock>
    <CeefaxBlock title="HUMON MANAGER" color="yellow">
      <p>JOAK CAN BE CAUGHT WITH A JOAKBALL.</p>
      <p>JOAKBALLS ARE SOLD AT THE POKESHOP ON PAGE 810.</p>
    </CeefaxBlock>
    <div class="mgr-app" data-manager-secret="joak"></div>
    <SecretAwardBanner />
  </div>
</CeefaxLayout>

<style>
  .secret-block {
    grid-column: 1 / -1;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: 100%;
  }

  .secret-block :global(.ceefax-block) {
    width: fit-content;
    max-width: 100%;
  }

  .joak-tagline {
    color: var(--ceefax-cyan);
    letter-spacing: 0.05em;
  }
</style>
