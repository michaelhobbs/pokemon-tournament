---
import CeefaxLayout from '../../layouts/CeefaxLayout.astro';
import CeefaxBlock from '../../components/ceefax/CeefaxBlock.astro';
import CeefaxHeading from '../../components/ceefax/CeefaxHeading.astro';
import TrainerSprite from '../../components/ceefax/TrainerSprite.astro';
import { PLAYERS, findPlayer } from '../../data/players';
import { WEEKS } from '../../data/matches';
import { POKEMON_TYPES, analyzeTeam } from '../../data/pokemon';
import { spriteFor } from '../../data/pokemon-sprites';

export function getStaticPaths() {
	return PLAYERS.map((player) => ({
		params: { number: String(player.number) },
	}));
}

const { number } = Astro.params;
const player = findPlayer(Number(number));
if (!player) throw new Error(`Unknown player: ${number}`);

const results = WEEKS.flatMap((week) =>
	week.matches
		.filter((match) => match.p1 === player.number || match.p2 === player.number)
		.map((match) => {
			const isHome = match.p1 === player.number;
			const opponent = findPlayer(isHome ? match.p2 : match.p1);
			if (!opponent) throw new Error(`Unknown player in week ${week.number}`);
			const mine = isHome ? match.wins1 : match.wins2;
			const theirs = isHome ? match.wins2 : match.wins1;
			const played = mine !== undefined && theirs !== undefined;
			return {
				week: week.number,
				opponent,
				mine: mine ?? 0,
				theirs: theirs ?? 0,
				played,
				won: played ? mine! > theirs! : false,
			};
		}),
);

const pageNumber = String(400 + player.number);
const playerIndex = PLAYERS.findIndex((p) => p.number === player.number);
const prev = PLAYERS[playerIndex - 1];
const next = PLAYERS[playerIndex + 1];
const base = import.meta.env.BASE_URL;
const teamStats = analyzeTeam(player.team);
---

<CeefaxLayout title={`${player.name} ${player.epithet}`} pageNumber={pageNumber}>
	<CeefaxHeading text={`${player.name} ${player.epithet}`} color="cyan" />
	<TrainerSprite number={player.number} />
	<CeefaxBlock title="PROFILE" number={player.number} color="cyan">
		<p>HOMETOWN: {player.hometown}</p>
		<p>SIGNATURE: {player.signature}</p>
	</CeefaxBlock>
	<CeefaxBlock title="TEAM" number={player.number} color="yellow">
		<ol class="trainer-team">
			{player.team.map((pokemon) => {
				const sprite = spriteFor(pokemon);
				return (
					<li>
						{sprite && (
							<img
								class="team-sprite"
								src={sprite}
								alt={pokemon}
								width="40"
								height="40"
								loading="lazy"
							/>
						)}
						<span class="team-name">{pokemon}</span>
						{POKEMON_TYPES[pokemon] && (
							<span class="type-chip">{POKEMON_TYPES[pokemon].join('/')}</span>
						)}
					</li>
				);
			})}
		</ol>
	</CeefaxBlock>
	<CeefaxBlock title="TEAM ANALYSIS" number={player.number} color="magenta">
		<div class="team-analysis">
			<section class="analysis-group">
				<h3 class="analysis-label analysis-weak">WEAK TO</h3>
				{teamStats.weaknesses.length > 0 ? (
					<ul class="analysis-list">
						{teamStats.weaknesses.map((weakness) => (
							<li>
								<span class="analysis-type">{weakness.type}</span>
								<span class="analysis-count">×{weakness.count}</span>
								{weakness.quad && <span class="analysis-quad">4×</span>}
							</li>
						))}
					</ul>
				) : (
					<p class="analysis-empty">NONE</p>
				)}
			</section>
			<section class="analysis-group">
				<h3 class="analysis-label analysis-resist">RESISTS</h3>
				{teamStats.resistances.length > 0 ? (
					<ul class="analysis-list">
						{teamStats.resistances.map((resistance) => (
							<li>
								<span class="analysis-type">{resistance.type}</span>
								<span class="analysis-count">×{resistance.count}</span>
							</li>
						))}
					</ul>
				) : (
					<p class="analysis-empty">NONE</p>
				)}
			</section>
		</div>
		<p class="analysis-note">×N = POKÉMON AFFECTED — 4× = DOUBLE WEAKNESS</p>
	</CeefaxBlock>
	<CeefaxBlock title="RESULTS" number={player.number} color="green">
		<table class="trainer-results">
			<thead>
				<tr>
					<th scope="col">WEEK</th>
					<th scope="col">OPPONENT</th>
					<th scope="col">SCORE</th>
					<th scope="col">RESULT</th>
				</tr>
			</thead>
			<tbody>
				{results.map((result) => (
					<tr class={result.won ? 'result-win' : result.played ? 'result-loss' : ''}>
						<td>
							<a href={`${base}games/${result.week}`}>{result.week}</a>
						</td>
						<td>
							<a href={`${base}trainers/${result.opponent.number}`}>{result.opponent.name}</a>
						</td>
						<td>
							{result.played ? (
								`${result.mine} - ${result.theirs}`
							) : (
								'VS'
							)}
						</td>
						<td>{result.played ? (result.won ? 'W' : 'L') : '—'}</td>
					</tr>
				))}
			</tbody>
		</table>
	</CeefaxBlock>
	<nav class="trainer-nav" aria-label="Trainer pages">
		{prev ? (
			<a href={`${base}trainers/${prev.number}`}>{prev.name}</a>
		) : (
			<span aria-hidden="true"></span>
		)}
		<a href={`${base}trainers`}>400 DIRECTORY</a>
		{next ? (
			<a href={`${base}trainers/${next.number}`}>{next.name}</a>
		) : (
			<span aria-hidden="true"></span>
		)}
	</nav>
</CeefaxLayout>

<style>
	.trainer-team {
		margin: 0;
		display: grid;
		gap: 0.25rem;
	}

	.trainer-team li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.team-sprite {
		width: 40px;
		height: 40px;
		object-fit: contain;
		background: var(--ceefax-black);
		border: 1px solid var(--ceefax-black);
		image-rendering: pixelated;
		flex-shrink: 0;
	}

	.team-name {
		color: var(--ceefax-white);
	}

	.type-chip {
		background: var(--ceefax-black);
		color: var(--ceefax-white);
		border: 1px solid var(--ceefax-yellow);
		padding: 0 0.3rem;
		font-size: 0.75rem;
		margin-left: 0.4rem;
	}

	.team-analysis {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	@media (max-width: 30rem) {
		.team-analysis {
			grid-template-columns: 1fr;
		}
	}

	.analysis-label {
		margin: 0 0 0.4rem;
		font-size: 0.9rem;
		letter-spacing: 0.1em;
	}

	.analysis-weak {
		color: var(--ceefax-red);
	}

	.analysis-resist {
		color: var(--ceefax-green);
	}

	.analysis-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
		gap: 0.25rem 0.5rem;
	}

	.analysis-list li {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.analysis-type {
		font-weight: 700;
		color: var(--ceefax-white);
	}

	.analysis-weak .analysis-type {
		color: var(--ceefax-red);
	}

	.analysis-resist .analysis-type {
		color: var(--ceefax-green);
	}

	.analysis-count {
		color: var(--ceefax-white);
		font-size: 0.8rem;
	}

	.analysis-quad {
		background: var(--ceefax-red);
		color: var(--ceefax-black);
		font-weight: 700;
		padding: 0 0.25rem;
		font-size: 0.7rem;
	}

	.analysis-empty {
		margin: 0;
		color: var(--ceefax-white);
	}

	.analysis-note {
		margin: 0.75rem 0 0;
		color: var(--ceefax-cyan);
		font-size: 0.8rem;
	}

	.trainer-results {
		width: 100%;
		border-collapse: collapse;
	}

	.trainer-results th,
	.trainer-results td {
		border: 1px solid var(--ceefax-green);
		padding: 0.25rem 0.5rem;
		text-align: left;
	}

	.trainer-results th {
		background: var(--ceefax-green);
		color: var(--ceefax-black);
		font-weight: 700;
	}

	.trainer-results td {
		color: var(--ceefax-white);
	}

	.trainer-results td:first-child {
		color: var(--ceefax-yellow);
	}

	.trainer-results a {
		color: var(--ceefax-white);
		text-decoration: none;
	}

	.trainer-results a:hover {
		color: var(--ceefax-cyan);
	}

	.trainer-results .result-win td:last-child {
		color: var(--ceefax-green);
		font-weight: 700;
	}

	.trainer-results .result-loss td:last-child {
		color: var(--ceefax-red);
		font-weight: 700;
	}

	.trainer-nav {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-top: 0.5rem;
		border-top: 2px solid var(--ceefax-cyan);
	}

	.trainer-nav > :first-child {
		justify-self: start;
	}

	.trainer-nav > :nth-child(2) {
		justify-self: center;
	}

	.trainer-nav > :last-child {
		justify-self: end;
	}

	.trainer-nav a {
		text-decoration: none;
		color: var(--ceefax-yellow);
	}

	.trainer-nav a:hover {
		color: var(--ceefax-cyan);
	}
</style>
