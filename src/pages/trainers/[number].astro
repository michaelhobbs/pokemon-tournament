---
import CeefaxLayout from "../../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../../components/ceefax/CeefaxHeading.astro";
import TrainerSprite from "../../components/ceefax/TrainerSprite.astro";
import TeamList from "../../components/ceefax/TeamList.astro";
import TeamAnalysisBlock from "../../components/ceefax/TeamAnalysisBlock.astro";
import ResultsTable from "../../components/ceefax/ResultsTable.astro";
import GroupedBarChart from "../../components/ceefax/GroupedBarChart.astro";
import PokemonDossier from "../../components/ceefax/PokemonDossier.astro";
import { colourFor } from "../../data/matchups";
import { PLAYERS, findPlayer } from "../../data/players";
import {
  FIRST_HALF_WEEKS,
  SECOND_HALF_WEEKS,
  WEEKS,
  type Week,
} from "../../data/matches";
import { computeStandings } from "../../data/standings";
import { analyzeTeam } from "../../data/pokemon";
import { spriteFor } from "../../data/pokemon-sprites";
import { swapsFor, applySwaps } from "../../data/midseason";
import { awardWinners } from "../../data/awards";
import {
  getDistributedAwards,
  getAwardRankings,
  getLateOnlyAwardsForPlayer,
  type AwardRankingEntry,
} from "../../data/award-distribution";
import PixelArt from "../../components/ceefax/PixelArt.astro";

export function getStaticPaths() {
  return PLAYERS.map((player) => ({
    params: { number: String(player.number) },
  }));
}

const { number } = Astro.params;
const player = findPlayer(Number(number));
if (!player) throw new Error(`Unknown player: ${number}`);

const buildResults = (weeks: Week[]) =>
  weeks.flatMap((week) =>
    week.matches
      .filter(
        (match) => match.p1 === player.number || match.p2 === player.number,
      )
      .map((match) => {
        const isHome = match.p1 === player.number;
        const opponent = findPlayer(isHome ? match.p2 : match.p1);
        if (!opponent) throw new Error(`Unknown player in week ${week.number}`);
        const mine = isHome ? match.wins1 : match.wins2;
        const theirs = isHome ? match.wins2 : match.wins1;
        const played = mine !== undefined && theirs !== undefined;
        return {
          week: week.number,
          opponent,
          mine: mine ?? 0,
          theirs: theirs ?? 0,
          played,
          won: played ? mine! > theirs! : false,
          late: match.isLate ?? false,
        };
      }),
  );

const firstHalfResults = buildResults(FIRST_HALF_WEEKS);
const secondHalfResults = buildResults(SECOND_HALF_WEEKS);

const swaps = swapsFor(player.number);
const hasSwaps = swaps.length > 0;
const secondTeam = applySwaps(player.team, swaps);
const firstHalfAnalysis = analyzeTeam(player.team);
const secondHalfAnalysis = analyzeTeam(secondTeam);

const pageNumber = String(400 + player.number);
const finalPosition =
  computeStandings(WEEKS).findIndex(
    (standing) => standing.player.number === player.number,
  ) + 1;
const lastTwo = finalPosition % 100;
const positionLabel = `${finalPosition}${
  lastTwo >= 11 && lastTwo <= 13
    ? "TH"
    : (["TH", "ST", "ND", "RD"][finalPosition % 10] ?? "TH")
}`;
const playerIndex = PLAYERS.findIndex((p) => p.number === player.number);
const prev = PLAYERS[playerIndex - 1];
const next = PLAYERS[playerIndex + 1];
const base = import.meta.env.BASE_URL;

const distributedAwards = getDistributedAwards();
const rankings = getAwardRankings();
const playerAwards = distributedAwards.filter((a) =>
  awardWinners(a).includes(player.number),
);
const lateOnlyAwards = getLateOnlyAwardsForPlayer(player.number);

const awardEntries = new Map<number, AwardRankingEntry>();
for (const award of distributedAwards) {
  if (award.hidden) continue;
  const entry = rankings
    .get(award.number)
    ?.find((ranking) => ranking.playerNumber === player.number);
  if (entry) awardEntries.set(award.number, entry);
}

const lateSuffix = (label: string): string =>
  /^[+-]/.test(label) ? ` ${label}` : ` + ${label}`;
---

<CeefaxLayout
  title={`${player.name} ${player.epithet}`}
  pageNumber={pageNumber}
>
  <CeefaxHeading text={`${player.name} ${player.epithet}`} color="cyan" />
  <TrainerSprite number={player.number} />
  <CeefaxBlock title="PROFILE" number={player.number} color="cyan">
    <p>FINAL POSITION: {positionLabel}</p>
    <p>HOMETOWN: {player.hometown}</p>
    <p>SIGNATURE: {player.signature}</p>
  </CeefaxBlock>
  {
    playerAwards.length > 0 && (
      <>
        <CeefaxHeading text="AWARDS" color="yellow" />
        <CeefaxBlock title="AWARDS WON" number={player.number} color="yellow">
          <ul class="trainer-awards-list">
            {playerAwards.map((award) => {
              const entry = awardEntries.get(award.number);
              return (
                <li class="trainer-award-item">
                  <a
                    href={`${base}awards/${award.number}`}
                    class="trainer-award-link"
                  >
                    <span class="trainer-award-sprite">
                      <PixelArt sprite={award.sprite} size="2.5rem" />
                    </span>
                    <span class="trainer-award-info">
                      <span class="trainer-award-number">{award.number}</span>
                      <span class="trainer-award-name">
                        {award.name}
                        {entry && (
                          <span class="trainer-award-count">
                            {" "}
                            ({entry.scoreLabel}
                            {entry.lateScoreLabel && (
                              <span class="trainer-award-late">
                                {lateSuffix(entry.lateScoreLabel)}
                              </span>
                            )}
                            )
                          </span>
                        )}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </CeefaxBlock>
      </>
    )
  }
  {
    lateOnlyAwards.length > 0 && (
      <>
        <CeefaxHeading text="LATE GAME AWARDS" color="magenta" />
        <CeefaxBlock
          title="IF LATE GAMES COUNTED"
          number={player.number}
          color="magenta"
        >
          <ul class="trainer-awards-list">
            {lateOnlyAwards.map((award) => {
              const entry = awardEntries.get(award.number);
              return (
                <li class="trainer-award-item">
                  <a
                    href={`${base}awards/${award.number}`}
                    class="trainer-award-link trainer-late-award-link"
                  >
                    <span class="trainer-award-sprite">
                      <PixelArt sprite={award.sprite} size="2.5rem" />
                    </span>
                    <span class="trainer-award-info">
                      <span class="trainer-award-number">{award.number}</span>
                      <span class="trainer-late-award-name">
                        {award.name}
                        {entry && (
                          <span class="trainer-award-count">
                            {" "}
                            ({entry.scoreLabel}
                            {entry.lateScoreLabel && (
                              <span class="trainer-award-late">
                                {lateSuffix(entry.lateScoreLabel)}
                              </span>
                            )}
                            )
                          </span>
                        )}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </CeefaxBlock>
      </>
    )
  }
  <CeefaxHeading text={hasSwaps ? "1ST HALF" : "1ST & 2ND HALF"} color="cyan" />
  <CeefaxBlock title="TEAM" number={player.number} color="yellow">
    <TeamList team={player.team} dossier={secondTeam} />
  </CeefaxBlock>
  <CeefaxBlock title="TEAM ANALYSIS" number={player.number} color="magenta">
    <TeamAnalysisBlock analysis={firstHalfAnalysis} />
  </CeefaxBlock>
  <CeefaxBlock title="RESULTS" number={player.number} color="green">
    <ResultsTable results={firstHalfResults} />
  </CeefaxBlock>
  {
    !hasSwaps && (
      <CeefaxBlock
        title="2ND HALF RESULTS"
        number={player.number}
        color="green"
      >
        <ResultsTable results={secondHalfResults} />
      </CeefaxBlock>
    )
  }
  <CeefaxHeading text="SUBSTITUTES" color="magenta" />
  <CeefaxBlock title="MID-SEASON DRAFT" number={player.number} color="magenta">
    {
      hasSwaps ? (
        <ul class="swap-list">
          {swaps.map((swap) => {
            const removedSprite = spriteFor(swap.removed);
            const replacementSprite = spriteFor(swap.replacement);
            return (
              <li class="swap-row">
                <div class="swap-poke">
                  {removedSprite && (
                    <img
                      class="swap-sprite"
                      src={removedSprite}
                      alt={swap.removed}
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                  )}
                  <span class="swap-name">{swap.removed}</span>
                </div>
                <span class="swap-arrow" aria-hidden="true">
                  →
                </span>
                <div class="swap-poke">
                  {replacementSprite && (
                    <img
                      class="swap-sprite"
                      src={replacementSprite}
                      alt={swap.replacement}
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                  )}
                  <span class="swap-name">{swap.replacement}</span>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="no-swaps">NO SUBSTITUTES DRAFTED</p>
      )
    }
  </CeefaxBlock>
  {
    hasSwaps && (
      <>
        <CeefaxHeading text="2ND HALF" color="yellow" />
        <CeefaxBlock title="TEAM" number={player.number} color="yellow">
          <TeamList team={secondTeam} dossier={secondTeam} />
        </CeefaxBlock>
        <CeefaxBlock
          title="TEAM ANALYSIS"
          number={player.number}
          color="magenta"
        >
          <TeamAnalysisBlock analysis={secondHalfAnalysis} />
        </CeefaxBlock>
        <CeefaxBlock title="RESULTS" number={player.number} color="green">
          <ResultsTable results={secondHalfResults} />
        </CeefaxBlock>
      </>
    )
  }
  <div class="trainer-chart">
    <CeefaxBlock
      title="TEAM STATS (MAX, LEVEL 100)"
      number={player.number}
      color="green"
    >
      <GroupedBarChart team={secondTeam} />
    </CeefaxBlock>
  </div>
  <div class="trainer-dossiers">
    <CeefaxHeading text="POKEDEX ENTRIES" color="green" />
    {
      secondTeam.map((pokemon) => (
        <PokemonDossier
          name={pokemon}
          colour={colourFor(player.number)}
          number={player.number}
        />
      ))
    }
  </div>
  <nav class="trainer-nav" aria-label="Trainer pages">
    {
      prev ? (
        <a href={`${base}trainers/${prev.number}`}>{prev.name}</a>
      ) : (
        <span aria-hidden="true" />
      )
    }
    <a href={`${base}trainers`}>400 DIRECTORY</a>
    {
      next ? (
        <a href={`${base}trainers/${next.number}`}>{next.name}</a>
      ) : (
        <span aria-hidden="true" />
      )
    }
  </nav>
</CeefaxLayout>

<style>
  .swap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .swap-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .swap-poke {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-width: 64px;
  }

  .swap-sprite {
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: var(--ceefax-black);
    border: 1px solid var(--ceefax-black);
    image-rendering: pixelated;
  }

  .swap-name {
    color: var(--ceefax-white);
    text-align: center;
  }

  .swap-arrow {
    color: var(--ceefax-yellow);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .no-swaps {
    margin: 0;
    color: var(--ceefax-yellow);
    font-weight: 700;
  }

  .trainer-awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .trainer-award-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ceefax-white);
  }

  .trainer-award-link:hover {
    color: var(--ceefax-cyan);
  }

  .trainer-award-sprite {
    display: block;
  }

  .trainer-award-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .trainer-award-number {
    background: var(--ceefax-black);
    color: var(--ceefax-yellow);
    font-weight: 700;
    padding: 0 0.4rem;
  }

  .trainer-award-name {
    color: var(--ceefax-yellow);
    font-weight: 700;
  }

  .trainer-award-link:hover .trainer-award-name {
    color: var(--ceefax-cyan);
  }

  .trainer-late-award-link:hover {
    color: var(--ceefax-magenta);
  }

  .trainer-late-award-link .trainer-award-number {
    background: var(--ceefax-magenta);
    color: var(--ceefax-black);
  }

  .trainer-late-award-name {
    color: var(--ceefax-magenta);
    font-weight: 700;
  }

  .trainer-late-award-link:hover .trainer-late-award-name {
    color: var(--ceefax-cyan);
  }

  .trainer-award-count {
    color: var(--ceefax-cyan);
    font-weight: 700;
  }

  .trainer-award-late {
    color: var(--ceefax-magenta);
  }

  .trainer-chart {
    grid-column: 1 / -1;
  }

  .trainer-dossiers {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
  }

  .trainer-nav {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 2px solid var(--ceefax-cyan);
  }

  .trainer-nav > :first-child {
    justify-self: start;
  }

  .trainer-nav > :nth-child(2) {
    justify-self: center;
  }

  .trainer-nav > :last-child {
    justify-self: end;
  }

  .trainer-nav a {
    text-decoration: none;
    color: var(--ceefax-yellow);
  }

  .trainer-nav a:hover {
    color: var(--ceefax-cyan);
  }
</style>
