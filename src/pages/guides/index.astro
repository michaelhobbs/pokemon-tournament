---
import CeefaxLayout from "../../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../../components/ceefax/CeefaxBlock.astro";
import CeefaxHeading from "../../components/ceefax/CeefaxHeading.astro";
import { GUIDE_GROUPS } from "../../data/guides";

const base = import.meta.env.BASE_URL;
---

<CeefaxLayout title="GUIDES" pageNumber="G00" noindex>
  <CeefaxHeading text="GUIDE INDEX" color="cyan" />
  {
    GUIDE_GROUPS.map((group) => (
      <CeefaxBlock title={group.title} number={group.pageNumber} color="yellow">
        <ul class="guide-index-list">
          <li class="guide-index-all">
            <a href={`${base}guides/${group.slug}`}>OPEN FULL PAGE</a>
          </li>
          {group.guides.map((guide) => (
            <li>
              <a href={`${base}guides/${group.slug}#guide-${guide.file}`}>
                {guide.label}
              </a>
            </li>
          ))}
        </ul>
      </CeefaxBlock>
    ))
  }
</CeefaxLayout>

<style>
  .guide-index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .guide-index-list a {
    color: var(--ceefax-white);
    text-decoration: none;
  }

  .guide-index-list a:hover,
  .guide-index-list a:focus-visible {
    color: var(--ceefax-cyan);
    text-decoration: underline;
  }

  .guide-index-all {
    margin-bottom: 0.1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--ceefax-white);
  }

  .guide-index-all a {
    color: var(--ceefax-yellow);
    font-weight: 700;
  }
</style>
