---
import type { MarkdownInstance } from "astro";
import CeefaxLayout from "../../layouts/CeefaxLayout.astro";
import { GUIDE_GROUPS } from "../../data/guides";

const guides = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
  "../../*.md",
  { eager: true },
);

export function getStaticPaths() {
  return GUIDE_GROUPS.map((group) => ({
    params: { trainer: group.slug },
  }));
}

const { trainer } = Astro.params;
const group = GUIDE_GROUPS.find((entry) => entry.slug === trainer);
if (!group) throw new Error(`Unknown guide group: ${trainer}`);

const sections = group.guides.map((entry) => {
  const mod = guides[`../../${entry.file}.md`];
  if (!mod) throw new Error(`Missing guide markdown: ${entry.file}.md`);
  return { ...entry, Content: mod.Content };
});

const configuredFiles = new Set(
  GUIDE_GROUPS.flatMap((entry) => entry.guides.map((guide) => guide.file)),
);
const availableFiles = new Set(
  Object.keys(guides).map((path) =>
    path.slice(path.lastIndexOf("/") + 1, -".md".length),
  ),
);
const unconfiguredFiles = [...availableFiles].filter(
  (file) => !configuredFiles.has(file),
);
if (unconfiguredFiles.length > 0) {
  throw new Error(
    `Unconfigured guide markdown: ${unconfiguredFiles.join(", ")}`,
  );
}
---

<CeefaxLayout title={group.title} pageNumber={group.pageNumber} noindex>
  <div class="guide-page">
    <nav class="guide-toc" aria-label="Guide contents">
      <h2 class="guide-toc-title">CONTENTS</h2>
      <ol>
        {
          sections.map(({ file, label }) => (
            <li>
              <a href={`#guide-${file}`}>{label}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="guide-prose">
      {
        sections.map((section) => {
          const Content = section.Content;
          return (
            <section
              id={`guide-${section.file}`}
              class="guide-section"
              aria-label={section.label}
            >
              <Content />
            </section>
          );
        })
      }
    </div>
  </div>
</CeefaxLayout>

<style>
  .guide-page {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
  }

  .guide-toc {
    border: 2px solid var(--ceefax-cyan);
    background: rgba(0, 255, 255, 0.06);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .guide-toc-title {
    margin: 0 0 0.5rem;
    color: var(--ceefax-yellow);
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  .guide-toc ol {
    margin: 0;
    padding-left: 1.4rem;
    columns: 2;
    column-gap: 2rem;
  }

  .guide-toc li {
    break-inside: avoid;
    margin: 0.2rem 0;
  }

  .guide-toc a {
    color: var(--ceefax-white);
    text-decoration: none;
  }

  .guide-toc a:hover,
  .guide-toc a:focus-visible {
    color: var(--ceefax-cyan);
    text-decoration: underline;
  }

  .guide-prose {
    text-transform: none;
    font-size: 1rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .guide-prose :global(h1) {
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--ceefax-cyan);
    color: var(--ceefax-yellow);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.2;
  }

  .guide-prose :global(h2) {
    margin: 2rem 0 0.6rem;
    color: var(--ceefax-cyan);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .guide-prose :global(h3) {
    margin: 1.5rem 0 0.5rem;
    color: var(--ceefax-magenta);
    font-size: 1.05rem;
  }

  .guide-prose :global(h4),
  .guide-prose :global(h5),
  .guide-prose :global(h6) {
    margin: 1.25rem 0 0.4rem;
    color: var(--ceefax-green);
    font-size: 1rem;
  }

  .guide-prose :global(p) {
    margin: 0.75rem 0;
  }

  .guide-prose :global(ul),
  .guide-prose :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }

  .guide-prose :global(li) {
    margin: 0.3rem 0;
  }

  .guide-prose :global(li > p) {
    margin: 0.25rem 0;
  }

  .guide-prose :global(strong) {
    color: var(--ceefax-yellow);
  }

  .guide-prose :global(em) {
    color: var(--ceefax-cyan);
  }

  .guide-prose :global(a) {
    color: var(--ceefax-cyan);
    text-decoration: underline;
  }

  .guide-prose :global(a:hover),
  .guide-prose :global(a:focus-visible) {
    color: var(--ceefax-yellow);
  }

  .guide-prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border-left: 4px solid var(--ceefax-magenta);
    background: rgba(255, 0, 255, 0.08);
    color: var(--ceefax-white);
  }

  .guide-prose :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .guide-prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .guide-prose :global(hr) {
    margin: 2rem 0;
    border: 0;
    border-top: 1px dashed var(--ceefax-white);
  }

  .guide-prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1rem 0;
    border-collapse: collapse;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  .guide-prose :global(th),
  .guide-prose :global(td) {
    border: 1px solid var(--ceefax-cyan);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }

  .guide-prose :global(th) {
    background: var(--ceefax-cyan);
    color: var(--ceefax-black);
    font-weight: 700;
  }

  .guide-prose :global(tbody tr:nth-child(even) td) {
    background: rgba(0, 255, 255, 0.06);
  }

  .guide-prose :global(pre) {
    margin: 1rem 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--ceefax-cyan);
    background: #050505;
    color: var(--ceefax-white);
    overflow-x: auto;
    line-height: 1.45;
  }

  .guide-prose :global(pre code) {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: 0.9rem;
  }

  .guide-prose :global(code) {
    padding: 0.1em 0.3em;
    border: 1px solid rgba(0, 255, 255, 0.35);
    background: #050505;
    color: var(--ceefax-yellow);
    font-size: 0.92em;
  }

  .guide-prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .guide-section {
    scroll-margin-top: 9rem;
  }

  .guide-section + .guide-section {
    margin-top: 2.5rem;
    padding-top: 0.5rem;
    border-top: 2px solid var(--ceefax-cyan);
  }

  @media (max-width: 640px) {
    .guide-toc ol {
      columns: 1;
    }
  }
</style>
