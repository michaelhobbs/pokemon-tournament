---
import CeefaxLayout from "../layouts/CeefaxLayout.astro";
import CeefaxBlock from "../components/ceefax/CeefaxBlock.astro";
import NavigationHotkeys from "../components/ceefax/NavigationHotkeys.astro";
import TournamentGraphic from "../components/ceefax/TournamentGraphic.astro";
import PageDirectory from "../components/ceefax/PageDirectory.astro";
import { PAGES } from "../data/navigation";

const base = import.meta.env.BASE_URL;
---

<CeefaxLayout title="TOURNAMENT" pageNumber="100">
  <div class="home-hero">
    <TournamentGraphic />
  </div>
  <CeefaxBlock title="STATUS" number="1" color="green">
    <p>
      <span class="home-status-arrow" aria-hidden="true">▶</span>
      <a class="home-status-link" href={`${base}games/11`}
        ><b>2ND ROUND ROBIN - WEEK 11</b></a
      >
    </p>
    <p>
      <a class="home-status-link" href={`${base}standings/draft-mid`}
        ><span class="home-status-arrow" aria-hidden="true">▶</span> VIEW MID-SEASON
        DRAFT</a
      >
    </p>
    <p>
      <a class="home-status-link" href={`${base}standings`}
        ><span class="home-status-arrow" aria-hidden="true">▶</span> VIEW STANDINGS</a
      >
    </p>
    <p>
      <a class="home-status-link" href={`${base}games/10`}
        ><span class="home-status-arrow" aria-hidden="true">▶</span> VIEW WEEK 10
        RESULTS</a
      >
    </p>
  </CeefaxBlock>
  <CeefaxBlock title="NAVIGATION HOTKEYS" number="2" color="yellow">
    <NavigationHotkeys />
  </CeefaxBlock>
  <PageDirectory pages={PAGES} />
</CeefaxLayout>

<style>
  .home-hero {
    grid-column: 1 / -1;
  }

  .home-status-link {
    color: var(--ceefax-magenta);
    font-weight: 400;
    text-decoration: none;
  }

  .home-status-arrow {
    color: var(--ceefax-magenta);
    font-size: 0.8em;
  }

  .home-status-link:hover {
    color: var(--ceefax-cyan);
  }

  .home-status-link:hover .home-status-arrow {
    color: var(--ceefax-cyan);
  }
</style>
