---
import CeefaxLayout from '../layouts/CeefaxLayout.astro';
import CeefaxBlock from '../components/ceefax/CeefaxBlock.astro';
import CeefaxHeading from '../components/ceefax/CeefaxHeading.astro';
import SecretAwardBanner from '../components/ceefax/SecretAwardBanner.astro';
import SecretQuote from '../components/ceefax/SecretQuote.astro';
---

<CeefaxLayout title="PAGE NOT FOUND" pageNumber="404">
	<SecretQuote />
	<CeefaxHeading text="404 — PAGE NOT FOUND" color="red" />
	<CeefaxBlock title="ERROR" number="404" color="red">
		<p>THE PAGE YOU ARE LOOKING FOR DOES NOT EXIST.</p>
		<p>YOU MIGHT HAVE TYPED THE WRONG PAGE NUMBER.</p>
		<p>
			<a href={`${import.meta.env.BASE_URL}`}>GO BACK TO HOME (100)</a>
		</p>
	</CeefaxBlock>
	<SecretAwardBanner />
</CeefaxLayout>

<style>
	.ceefax-block {
		grid-column: 1 / -1;
		justify-self: center;
		width: fit-content;
		max-width: 100%;
	}

	p {
		margin: 0.25rem 0;
	}

	a {
		color: var(--ceefax-red);
		font-weight: 700;
	}
</style>
