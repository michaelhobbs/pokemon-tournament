---
import type { PixelArt } from "../../data/trophy";

interface Props {
  sprite: PixelArt;
  size?: string;
  label?: string;
  decorative?: boolean;
}

const {
  sprite,
  size = "10rem",
  label = "Pixel art sprite",
  decorative = false,
} = Astro.props;
const rows = sprite.map.length;
const cols = sprite.map[0]?.length ?? 0;

const pixels = sprite.map.flatMap((row) =>
  [...row].map((char) => {
    const color = char === "." ? null : sprite.palette[char];
    return { color };
  }),
);
---

<div
  class="pixel-art"
  style={`--art-cols: ${cols}; --art-rows: ${rows}; --art-size: ${size};`}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? "true" : undefined}
>
  {
    pixels.map(({ color }) => (
      <span class="pixel" style={color ? `background: ${color};` : undefined} />
    ))
  }
</div>

<style>
  .pixel-art {
    display: grid;
    grid-template-columns: repeat(var(--art-cols), 1fr);
    grid-template-rows: repeat(var(--art-rows), 1fr);
    width: var(--art-size);
    max-width: 100%;
    aspect-ratio: var(--art-cols) / var(--art-rows);
    gap: 0;
  }

  .pixel {
    width: 100%;
    aspect-ratio: 1;
  }
</style>
