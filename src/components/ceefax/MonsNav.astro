---
import { MONS_DIRECTORY_PAGE, MONS_DIRECTORY_PAGES } from '../../data/navigation';

interface Props {
	current: string;
}

const { current } = Astro.props;
const index = MONS_DIRECTORY_PAGES.findIndex((page) => page.number === current);
const prev = index > 1 ? MONS_DIRECTORY_PAGES[index - 1] : undefined;
const next = index >= 0 && index < MONS_DIRECTORY_PAGES.length - 1 ? MONS_DIRECTORY_PAGES[index + 1] : undefined;
---

<nav class="mons-nav" aria-label="Mons pages">
	{prev ? (
		<a href={prev.href}>{prev.number} {prev.label}</a>
	) : (
		<span aria-hidden="true"></span>
	)}
	<a href={MONS_DIRECTORY_PAGE.href}>{MONS_DIRECTORY_PAGE.number} {MONS_DIRECTORY_PAGE.label}</a>
	{next ? (
		<a href={next.href}>{next.number} {next.label}</a>
	) : (
		<span aria-hidden="true"></span>
	)}
</nav>

<style>
	.mons-nav {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-top: 0.5rem;
		border-top: 2px solid var(--ceefax-cyan);
	}

	.mons-nav > :first-child {
		justify-self: start;
	}

	.mons-nav > :nth-child(2) {
		justify-self: center;
	}

	.mons-nav > :last-child {
		justify-self: end;
	}

	.mons-nav a {
		text-decoration: none;
		color: var(--ceefax-yellow);
	}

	.mons-nav a:hover {
		color: var(--ceefax-cyan);
	}
</style>
