---
interface TickerEntry {
  text: string;
  href?: string;
}

interface Props {
  pageNumber?: string;
  ticker?: Array<string | TickerEntry>;
}

const base = import.meta.env.BASE_URL;

const {
  pageNumber = "001",
  ticker = [
    "WELCOME TO SEASON 3!",
    { text: "CHECK OUT PROGRESS TOWARDS AWARDS", href: `${base}awards` },
    "ILEX FOREST CITIZENS PREPARING CELEBRATIONS EARLY",
    "AN UPSET IS STILL POSSIBLE",
    "TIGHT FIGHT FOR THE OTHER SPOTS ON THE PODIUM",
    "I 1 2 BREAK 3",
  ],
} = Astro.props;

const normaliseEntry = (entry: string | TickerEntry): TickerEntry =>
  typeof entry === "string" ? { text: entry } : entry;

const dateLabel = new Date()
  .toLocaleDateString("en-GB", {
    weekday: "short",
    day: "numeric",
    month: "short",
  })
  .toUpperCase();

const tickerSegments = (
  entry: string,
): Array<{ text: string; digit?: boolean }> =>
  entry
    .split(/([123])/)
    .map((part) =>
      /^[123]$/.test(part) ? { text: part, digit: true } : { text: part },
    );

const tickerEntries = ticker.map(normaliseEntry);
---

<footer class="ceefax-footer" transition:animate="none">
  <div class="ceefax-ticker">
    <div class="ceefax-ticker-track">
      <span class="ceefax-ticker-copy">
        {
          tickerEntries.map((entry) => (
            <span class="ceefax-ticker-item">
              {entry.href ? (
                <a class="ceefax-ticker-link" href={entry.href}>
                  {tickerSegments(entry.text).map((segment) =>
                    segment.digit ? (
                      <span class="ceefax-ticker-digit">{segment.text}</span>
                    ) : (
                      segment.text
                    ),
                  )}
                </a>
              ) : (
                tickerSegments(entry.text).map((segment) =>
                  segment.digit ? (
                    <span class="ceefax-ticker-digit">{segment.text}</span>
                  ) : (
                    segment.text
                  ),
                )
              )}
            </span>
          ))
        }
      </span>
      <span class="ceefax-ticker-copy" aria-hidden="true">
        {
          tickerEntries.map((entry) => (
            <span class="ceefax-ticker-item">
              {entry.href ? (
                <a class="ceefax-ticker-link" href={entry.href} tabindex="-1">
                  {tickerSegments(entry.text).map((segment) =>
                    segment.digit ? (
                      <span class="ceefax-ticker-digit">{segment.text}</span>
                    ) : (
                      segment.text
                    ),
                  )}
                </a>
              ) : (
                tickerSegments(entry.text).map((segment) =>
                  segment.digit ? (
                    <span class="ceefax-ticker-digit">{segment.text}</span>
                  ) : (
                    segment.text
                  ),
                )
              )}
            </span>
          ))
        }
      </span>
    </div>
  </div>
  <div class="ceefax-statusbar">
    <span>POKEFAX</span>
    <span class="ceefax-statusbar-center">{dateLabel}</span>
    <span id="ceefax-footer-page">PAGE {pageNumber}</span>
  </div>
</footer>

<style>
  .ceefax-ticker {
    overflow: hidden;
    white-space: nowrap;
    background: var(--ceefax-blue);
    color: var(--ceefax-white);
    border-top: 3px solid var(--ceefax-cyan);
    padding: 0.15rem 0;
  }

  .ceefax-ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: ceefax-scroll 30s linear infinite;
  }

  .ceefax-ticker-copy {
    display: inline-flex;
    white-space: nowrap;
  }

  .ceefax-ticker-item {
    padding-right: 3rem;
  }

  .ceefax-ticker-digit {
    color: var(--ceefax-magenta);
    font-weight: 700;
  }

  .ceefax-ticker-link {
    background: var(--ceefax-magenta);
    color: var(--ceefax-black);
    font-weight: 700;
    padding: 0 0.35rem;
    text-decoration: none;
  }

  .ceefax-ticker-link:hover,
  .ceefax-ticker-link:focus-visible {
    color: var(--ceefax-black);
    text-decoration: underline;
  }

  .ceefax-ticker-item::after {
    content: "▲";
    color: var(--ceefax-yellow);
    margin-left: 1.5rem;
  }

  .ceefax-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--ceefax-black);
    color: var(--ceefax-yellow);
    border-top: 3px solid var(--ceefax-cyan);
    padding: 0.15rem 0.75rem;
  }

  .ceefax-statusbar-center {
    color: var(--ceefax-white);
  }

  @keyframes ceefax-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
