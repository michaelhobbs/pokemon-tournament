---
import PixelArt from './PixelArt.astro';
import { HUMON } from '../../data/humon';

interface Props {
  title: string;
  pageNumber?: string;
  subtitle?: string;
}

const {
  title,
  pageNumber = '001',
  subtitle = 'POKEMON TOURNAMENT',
} = Astro.props;
---

<header class="ceefax-header" transition:animate="none">
  <div class="ceefax-topbar">
    <span class="ceefax-topbar-item">PAGE {pageNumber}</span>
    <span class="ceefax-topbar-item ceefax-topbar-center">{subtitle}</span>
    <span
      class="ceefax-topbar-item"
      id="ceefax-clock"
      transition:persist
      aria-hidden="true">--:--/--</span
    >
  </div>
  <div class="ceefax-titlerow">
    <div class="ceefax-title-wrap">
      <h1 class="ceefax-title">{title}</h1>
      <span
        class="ceefax-humon"
        id="ceefax-humon"
        transition:persist
        role="button"
        tabindex="0"
        aria-label="HUMON"
      >
        <PixelArt sprite={HUMON} size="100%" decorative />
        <span class="ceefax-humon-bubble ceefax-humon-msg" role="status">
          I USED TO BE TRAINER.<br />NOW I'M A MON.<br />I STILL HAVE MY TEAM
          THOUGH.<br />POKECEPTION!
        </span>
        <span class="ceefax-humon-bubble ceefax-humon-msg2" role="status">
          THERE IS A LEGEND OF A HIDDEN PAGE SOMEWHERE BUT I HAVE&nbsp;<a
            class="humon-page"
            href={`${import.meta.env.BASE_URL}000`}
            >000</a
          >&nbsp;IDEA WHERE IT IS…
        </span>
      </span>
    </div>
    <span
      class="ceefax-pagebox"
      id="ceefax-pagebox"
      role="button"
      tabindex="0"
      title="Click to enter a page number"
      aria-label="Enter a page number">{pageNumber}</span
    >
  </div>
</header>

<style>
  .ceefax-header {
    z-index: 1;
  }

  .ceefax-topbar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
    background: var(--ceefax-cyan);
    color: var(--ceefax-black);
    font-weight: 700;
    padding: 0.15rem 0.75rem;
  }

  .ceefax-topbar-center {
    text-align: center;
  }

  .ceefax-titlerow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 3px solid var(--ceefax-cyan);
  }

  .ceefax-title {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: 0.12em;
    color: var(--ceefax-yellow);
  }

  .ceefax-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ceefax-humon {
    position: relative;
    display: inline-block;
    width: 2.1rem;
    flex-shrink: 0;
    visibility: hidden;
    opacity: 0;
    cursor: pointer;
    filter: drop-shadow(0 0 6px rgba(0, 255, 255, 0.4));
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .ceefax-humon.has-humon {
    visibility: visible;
    opacity: 1;
    animation: ceefax-humon-bob 2.8s ease-in-out infinite;
  }

  .ceefax-humon-bubble {
    position: absolute;
    left: 50%;
    top: calc(100% + 10px);
    transform: translateX(-50%) translateY(-6px);
    background: var(--ceefax-yellow);
    color: var(--ceefax-black);
    font-weight: 700;
    margin: 0;
    padding: 0.35rem 0.8rem;
    border: 2px solid var(--ceefax-black);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55);
    width: max-content;
    max-width: min(260px, 70vw);
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  .ceefax-humon.is-talking .ceefax-humon-msg,
  .ceefax-humon.is-talking-two .ceefax-humon-msg2 {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .ceefax-humon.is-talking-two .ceefax-humon-msg {
    opacity: 0;
  }

  .ceefax-humon-bubble::before,
  .ceefax-humon-bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
  }

  .ceefax-humon-bubble::before {
    top: -11px;
    border-bottom: 9px solid var(--ceefax-black);
  }

  .ceefax-humon-bubble::after {
    top: -7px;
    border-bottom: 7px solid var(--ceefax-yellow);
  }

  .ceefax-humon-bubble .humon-page {
    background: var(--ceefax-magenta);
    color: var(--ceefax-black);
    font-weight: 700;
    padding: 0 0.2em;
  }

  .ceefax-humon-bubble a.humon-page {
    text-decoration: none;
  }

  .ceefax-humon-bubble a.humon-page:hover {
    text-decoration: underline;
  }

  @keyframes ceefax-humon-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ceefax-humon.has-humon {
      animation: none;
    }
  }

  .ceefax-pagebox {
    background: var(--ceefax-magenta);
    color: var(--ceefax-black);
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    width: 3ch;
    min-width: 0;
    box-sizing: content-box;
  }

  .ceefax-pagebox[data-unknown='true'] {
    background: var(--ceefax-red);
    color: var(--ceefax-white);
  }
</style>

<script is:inline>
  const clock = document.getElementById('ceefax-clock');
  const pad = (n) => String(n).padStart(2, '0');
  const render = () => {
    const d = new Date();
    clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}/${pad(d.getSeconds())}`;
  };
  render();
  setInterval(render, 1000);

  // Keep in sync with HUMON_STORAGE_KEY in src/data/humon.ts
  const STORAGE_KEY = 'pkm:humon-caught';
  const humon = document.getElementById('ceefax-humon');
  const syncHumon = () => {
    let caught = false;
    try {
      caught = sessionStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      caught = false;
    }
    if (humon) humon.classList.toggle('has-humon', caught);
  };
  window.addEventListener('humon:caught', syncHumon);
  syncHumon();

  if (humon) {
    let msgIndex = 0;
    const isLinkTarget = (event) => {
      const target = event.target;
      return !!target && typeof target.closest === 'function' && target.closest('a');
    };
    const talk = (event) => {
      if (isLinkTarget(event)) return;
      msgIndex = (msgIndex + 1) % 3;
      if (msgIndex === 0) {
        humon.classList.remove('is-talking', 'is-talking-two');
      } else {
        humon.classList.add('is-talking');
        humon.classList.toggle('is-talking-two', msgIndex === 2);
      }
    };
    humon.addEventListener('click', talk);
    humon.addEventListener('keydown', (event) => {
      if (isLinkTarget(event)) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        talk();
      }
    });
  }
</script>
