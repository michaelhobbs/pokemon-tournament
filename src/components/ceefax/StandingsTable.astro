---
import type { Week } from "../../data/matches";
import { computeStandings } from "../../data/standings";
import LateNote from "./LateNote.astro";

interface Props {
  weeks: Week[];
}

const { weeks } = Astro.props;
const base = import.meta.env.BASE_URL;

const rows = computeStandings(weeks);
const hasLate = rows.some(
  ({ late }) => late.played > 0 || late.wins > 0 || late.battles > 0,
);
---

<table class="standings">
  <thead>
    <tr>
      <th scope="col">POS</th>
      <th scope="col">TRAINER</th>
      <th scope="col" title="MATCHES PLAYED">P</th>
      <th scope="col">W</th>
      <th scope="col">B</th>
      <th scope="col">PTS</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ player, played, wins, battles, late }, index) => (
        <tr>
          <td>{index + 1}</td>
          <td>
            <a href={`${base}trainers/${player.number}`}>{player.name}</a>
          </td>
          <td>
            {played}
            {late.played > 0 && (
              <span class="standings-late"> + {late.played}</span>
            )}
          </td>
          <td>
            {wins}
            {late.wins > 0 && (
              <span class="standings-late"> + {late.wins}</span>
            )}
          </td>
          <td>
            {battles}
            {late.battles > 0 && (
              <span class="standings-late"> + {late.battles}</span>
            )}
          </td>
          <td>
            {wins * 3}
            {late.wins > 0 && (
              <span class="standings-late"> + {late.wins * 3}</span>
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
{hasLate && <LateNote text="X + Y: X = ON TIME, Y (PURPLE) = LATE" />}

<style>
  .standings {
    width: 100%;
    min-width: max-content;
    border-collapse: collapse;
  }

  .standings th,
  .standings td {
    border: 1px solid var(--ceefax-cyan);
    padding: 0.25rem 0.5rem;
    text-align: left;
  }

  .standings th {
    background: var(--ceefax-cyan);
    color: var(--ceefax-black);
    font-weight: 700;
  }

  .standings td {
    color: var(--ceefax-white);
  }

  .standings td:first-child {
    color: var(--ceefax-yellow);
  }

  .standings td a {
    color: var(--ceefax-cyan);
  }

  .standings-late {
    color: var(--ceefax-magenta);
    font-weight: 700;
  }
</style>
