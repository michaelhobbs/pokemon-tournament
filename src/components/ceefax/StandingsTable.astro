---
import type { Week } from "../../data/matches";
import { computeStandings } from "../../data/standings";

interface Props {
  weeks: Week[];
}

const { weeks } = Astro.props;
const base = import.meta.env.BASE_URL;

const rows = computeStandings(weeks);
---

<table class="standings">
  <thead>
    <tr>
      <th scope="col">POS</th>
      <th scope="col">TRAINER</th>
      <th scope="col" title="MATCHES PLAYED">P</th>
      <th scope="col">W</th>
      <th scope="col">B</th>
      <th scope="col">PTS</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ player, played, wins, battles }, index) => (
        <tr>
          <td>{index + 1}</td>
          <td>
            <a href={`${base}trainers/${player.number}`}>{player.name}</a>
          </td>
          <td>{played}</td>
          <td>{wins}</td>
          <td>{battles}</td>
          <td>{wins * 3}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .standings {
    width: 100%;
    min-width: max-content;
    border-collapse: collapse;
  }

  .standings th,
  .standings td {
    border: 1px solid var(--ceefax-cyan);
    padding: 0.25rem 0.5rem;
    text-align: left;
  }

  .standings th {
    background: var(--ceefax-cyan);
    color: var(--ceefax-black);
    font-weight: 700;
  }

  .standings td {
    color: var(--ceefax-white);
  }

  .standings td:first-child {
    color: var(--ceefax-yellow);
  }

  .standings td a {
    color: var(--ceefax-cyan);
  }
</style>
