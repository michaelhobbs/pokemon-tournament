---
import { POKEMON_TYPES } from '../../data/pokemon';
import { spriteFor } from '../../data/pokemon-sprites';

interface Props {
	team: string[];
}

const { team } = Astro.props;
---

<ol class="trainer-team">
	{team.map((pokemon) => {
		const sprite = spriteFor(pokemon);
		return (
			<li>
				{sprite && (
					<img
						class="team-sprite"
						src={sprite}
						alt={pokemon}
						width="40"
						height="40"
						loading="lazy"
					/>
				)}
				<span class="team-name">{pokemon}</span>
				{POKEMON_TYPES[pokemon] && (
					<span class="type-chip">{POKEMON_TYPES[pokemon].join('/')}</span>
				)}
			</li>
		);
	})}
</ol>

<style>
	.trainer-team {
		margin: 0;
		display: grid;
		gap: 0.25rem;
	}

	.trainer-team li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.team-sprite {
		width: 40px;
		height: 40px;
		object-fit: contain;
		background: var(--ceefax-black);
		border: 1px solid var(--ceefax-black);
		image-rendering: pixelated;
		flex-shrink: 0;
	}

	.team-name {
		color: var(--ceefax-white);
	}

	.type-chip {
		background: var(--ceefax-black);
		color: var(--ceefax-white);
		border: 1px solid var(--ceefax-yellow);
		padding: 0 0.3rem;
		font-size: 0.75rem;
		margin-left: 0.4rem;
	}
</style>
